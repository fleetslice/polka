# ИИ (только сервер). Без ключа ИИ-функции показывают «ИИ не подключён».
ANTHROPIC_API_KEY=
POLKA_AI_MODEL=claude-opus-5-5
# Лимит запросов к ИИ на один IP в минуту
POLKA_AI_RATE_PER_MIN=20
# Общий потолок запросов к ИИ в минуту на весь сервер
POLKA_AI_RATE_GLOBAL_PER_MIN=60

# Supabase (необязательно). Без него библиотека живёт локально в браузере.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
